# Copiar este archivo como .env (el .env NO se sube a git)
PORT=3000

# PostgreSQL 15 (db_siger) - ver docker-compose.yml en la raiz
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_siger
DB_USER=siger
DB_PASSWORD=siger_dev

# Clave para firmar los JWT (RNF-0005). Cambiarla en produccion.
JWT_SECRET=cambiar_esta_clave_en_produccion
JWT_EXPIRES_IN=8h

# Origen permitido del frontend (CORS)
CORS_ORIGIN=http://localhost:5173

# Integración SUNAT (ILA-0018). Mientras no haya proveedor OSE/PSE se usa un simulador.
# Modos: NORMAL | CAIDO | RESPUESTA_PERDIDA | RECHAZAR
SUNAT_SIMULADO_MODO=NORMAL
# Cada cuánto corre el Job de Reintentos (milisegundos)
JOB_INTERVALO_MS=15000
